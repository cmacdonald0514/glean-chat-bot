# Copy to .env and fill in. .env is gitignored; never commit real tokens.

# Glean deployment name. The SDK builds https://{instance}-be.glean.com from this.
GLEAN_INSTANCE=support-lab

# Used ONLY by the `index` command. The query path never loads this variable.
GLEAN_INDEXING_TOKEN=

# Used by search + chat. Scope: Chat, Search. Token type: Global.
GLEAN_CLIENT_TOKEN=

# The sandbox is shared with other candidates, so document IDs are namespaced
# by this datasource name plus GLEAN_DOC_ID_PREFIX below.
GLEAN_DATASOURCE=interviewds3

# Root of the local corpus that `index` walks. Read ONLY by the index command;
# the MCP server and the ask path never load it, so a query-only host can omit it.
GLEAN_DOCS_ROOT=data/Halcyon Shared Drive

# ---- optional, all have defaults ----

# Prefix applied to every pushed document ID. Belt-and-braces on top of the
# datasource namespace.
GLEAN_DOC_ID_PREFIX=halcyon

# Default number of passages retrieved per question. Applies to both the CLI and
# the MCP tool when the caller does not pass top_k explicitly.
GLEAN_TOP_K=5

# Characters of content requested per search result.
GLEAN_MAX_SNIPPET_SIZE=2000

# Relevance floor. See query/retrieval.py for why this is a term-overlap
# fraction and not a score threshold.
GLEAN_MIN_TERM_OVERLAP=0.30

# Required when GLEAN_CLIENT_TOKEN is a Global token: the email of the user to
# act as. Global tokens can act as anybody, so Glean requires you to say who.
# Leave empty if your client token is User-scoped.
GLEAN_ACT_AS=

# Chat generation timeout. The SDK default (~5s) is too short for generation.
GLEAN_CHAT_TIMEOUT_MS=60000
