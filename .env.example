# ---- required ----

# Glean deployment name. The SDK builds https://{instance}-be.glean.com from it.
GLEAN_INSTANCE=support-lab

# Write path only. The query path never loads this variable.
GLEAN_INDEXING_TOKEN=

# Read path only. Scope: Chat, Search. Token type: Global.
GLEAN_CLIENT_TOKEN=

# The sandbox is shared, so document IDs are namespaced by this name plus
GLEAN_DATASOURCE=interviewds3
GLEAN_DOCS_ROOT=data/Halcyon Shared Drive

# ---- optional, all have defaults ----
GLEAN_DOC_ID_PREFIX=halcyon
GLEAN_MIN_BODY_CHARS=200
GLEAN_TOP_K=5
GLEAN_MAX_SNIPPET_SIZE=2000
GLEAN_MIN_RESULTS=1
GLEAN_ACT_AS=
GLEAN_CHAT_TIMEOUT_MS=60000

# ---- the MCP server's listener, all optional ----
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*
