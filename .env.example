# Copy to .env and fill in. .env is gitignored; never commit real tokens.

# Glean deployment name. The SDK builds https://{instance}-be.glean.com from this.
GLEAN_INSTANCE=support-lab

# Used ONLY by the `glean-index` command. The query path never loads this variable.
GLEAN_INDEXING_TOKEN=

# Used by search + chat. Scope: Chat, Search. Token type: Global.
GLEAN_CLIENT_TOKEN=

# The sandbox is shared with other candidates, so document IDs are namespaced
# by this datasource name plus GLEAN_DOC_ID_PREFIX below.
GLEAN_DATASOURCE=interviewds3

# Root of the local corpus that `glean-index` walks. Read ONLY by the write
# path; the MCP server and the ask path never load it, so a query-only host can
# omit it. docker-compose.yml also uses it as the host side of the indexer's
# bind mount - inside that container the corpus is always at /app/data.
GLEAN_DOCS_ROOT=data/Halcyon Shared Drive

# ---- optional, all have defaults ----

# Prefix applied to every pushed document ID. Belt-and-braces on top of the
# datasource namespace.
GLEAN_DOC_ID_PREFIX=halcyon

# Default number of passages retrieved per question. Used when the MCP tool's
# caller does not pass top_k explicitly.
GLEAN_TOP_K=5

# Characters of content requested per search result.
GLEAN_MAX_SNIPPET_SIZE=2000

# Relevance floor. See glean_chat_bot/query/search.py for why this is a
# term-overlap fraction and not a score threshold.
GLEAN_MIN_TERM_OVERLAP=0.30

# Required when GLEAN_CLIENT_TOKEN is a Global token: the email of the user to
# act as. Global tokens can act as anybody, so Glean requires you to say who.
# Leave empty if your client token is User-scoped.
GLEAN_ACT_AS=

# Chat generation timeout. The SDK default (~5s) is too short for generation.
GLEAN_CHAT_TIMEOUT_MS=60000

# ---- the MCP server's own listener, all optional ----
# The container sets MCP_HOST=0.0.0.0 itself; compose publishes the port on
# loopback only. MCP_ALLOWED_HOSTS is the Host/Origin allowlist and is
# deliberately independent of the bind address — widening the bind does not
# widen this. --host and --port override these on the command line.
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*

# ---- the indexing service and its schedule, all optional ----
# `glean-indexd` serves the same indexing run as `glean-index` over HTTP, so it
# can be fired on a schedule and on demand without the MCP server ever gaining
# the ability to write. It reads GLEAN_INDEXING_TOKEN and never GLEAN_CLIENT_TOKEN.
#
# The container sets INDEXER_HOST=0.0.0.0 itself, and compose deliberately does
# NOT publish this port: POST /index is unauthenticated and rewrites the whole
# datasource, so the only ways in are the cron sidecar on the compose network
# and `docker compose exec indexer glean-index-trigger`.
INDEXER_PORT=8001

# When the indexer-cron sidecar fires, in standard five-field cron syntax.
# Wall-clock, not an interval: this is 03:00 daily, and a container restart does
# not shift it.
INDEX_SCHEDULE=0 3 * * *

# Where `glean-index-trigger` posts. compose sets this for the cron sidecar;
# leave it unset otherwise and the CLI defaults to 127.0.0.1:$INDEXER_PORT,
# which is what makes `docker compose exec indexer glean-index-trigger` work.
# INDEXER_URL=
